# Copy to .env and edit before running `docker compose up`.

# Shared signup code — anyone who knows this can create an account on your instance.
# Use a long random string. Change it to rotate access.
SIGNUP_CODE=change-me-to-a-long-random-string

# Host port to expose (container always listens on 3000 internally).
PORT=3000

# Encryption key for the database at rest (SQLCipher). Use a long random string, e.g.
#   openssl rand -base64 48
# ⚠️  BACK THIS UP somewhere safe and NEVER change it once you have data —
#     if this key is lost, your data is permanently unrecoverable.
DB_KEY=change-me-to-a-long-random-string
